<BaseLayout title="ESA Pages - Deploy Faster Than Ever">
  <head>
    <!-- 允许向目标域名传递基础 Origin，解决 QQ 浏览器 X5 内核的安全校验机制 -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
  </head>

  <script is:inline define:vars={{ TARGET_URL }}>
    (function() {
      var win = typeof window !== 'undefined' ? window : {};
      var nav = typeof navigator !== 'undefined' ? navigator : {};
      var ua = nav.userAgent || nav.vendor || win.opera || '';

      // 强化匹配：全面覆盖 QQ 浏览器、手机 QQ 内置浏览器、微信、微信小程序等环境
      var isQQOrWx = /MQQBrowser|QQ\/|MicroMessenger|QQTheme/i.test(ua);
      var isMobileUA = isQQOrWx || /Android|webOS|iPhone|iPod|iPad|BlackBerry|IEMobile|Opera Mini|Mobile|Quark|UCBrowser|Baidu/i.test(ua);
      
      var hasTouch = ('ontouchstart' in win) || (nav.maxTouchPoints > 0);
      var isWebDriver = !!nav.webdriver;

      if (isMobileUA && hasTouch && !isWebDriver) {
        if (document && document.documentElement) {
          document.documentElement.style.display = 'none';
        }
        
        // 针对 QQ 浏览器 / 微信环境：稍微延迟 50ms 确保 X5 内核完成安全上下文加载后再跳转
        if (isQQOrWx) {
          setTimeout(function() {
            win.location.replace(TARGET_URL);
          }, 50);
        } else {
          win.location.replace(TARGET_URL);
        }
      }
    })();
  </script>

  <Header />
  <main>
    <Hero />
    <Features />
    <Testimonials />
    <CTA />
  </main>
  <Footer />
</BaseLayout>
